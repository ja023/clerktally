<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CrewTally is offline-only and still declares NO network permission —
         in particular NO android.permission.INTERNET. A future library that tries to
         add it via manifest merge should be caught in review, not merged silently.

         READ_CONTACTS (Phase 1) backs the shared contact-search field (clerk name/phone,
         company contact person/phone). It is requested at runtime on first use of that
         field, once, and the app works as a plain form forever if denied — see
         ContactsPermissionStore / ContactSearchField. Declaring it here has no effect on
         its own; Android still gates the read behind the runtime grant. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".CrewTallyApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CrewTally">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.CrewTally">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Phase 5: grants the system share sheet temporary read access to generated report
             PDFs/text and backup JSON files under cacheDir/shared/ — never external storage,
             never a broadly-exported provider (android:exported="false", grantUriPermissions
             scoped per-Uri by FileProvider itself). See ui/util/ShareFile.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
