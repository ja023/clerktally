    <!-- Privacy (Phase 5) -->
    <string name="privacy_screen_title">Privacy</string>
    <string name="privacy_section_storage_heading">Data storage</string>
    <string name="privacy_section_storage_body">CrewTally is an offline app. Everything you enter, including companies, clerks, projects, attendance, and payments, stays on this device only. Nothing is sent anywhere.\n\nCrewTally does not collect or transmit any data.</string>
    <string name="privacy_section_contacts_heading">Contacts</string>
    <string name="privacy_section_contacts_body">When you search your contacts to fill in a clerk or company\'s name and phone number, CrewTally reads that contact information only at that moment, only to show matching suggestions. Nothing from your contacts is stored, sent, or used for any other purpose.</string>
    <string name="privacy_section_backups_heading">Backups</string>
    <string name="privacy_section_backups_body">You can export a backup of your data at any time from More, then Backup, and share that file however you choose. CrewTally never uploads it anywhere on its own.</string>
