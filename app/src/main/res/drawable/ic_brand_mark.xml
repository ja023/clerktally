<?xml version="1.0" encoding="utf-8"?>
<!--
  The CrewTally brand mark for IN-APP use (LOCKED 2026-09-21): a mid-grey square frame left
  open at its top-right corner, with a navy arrow breaking in through the opening (an L-shaped
  corner bracket, a 45 degree shaft, and an arrowhead pointing down-left into the frame).

  Same geometry and the same sampled fills (grey #6F7072, navy #013B7A) as design/logo.svg,
  on the identical 1000 viewport, so the two stay trivially comparable. Unlike
  drawable/ic_launcher_foreground.xml this file carries NO adaptive-icon safe-zone padding:
  the mark fills the viewport exactly as in the SVG, because in-app it is placed like an icon,
  not masked by a launcher shape.

  Single source of truth for the Compose placements (Home tab header, Reports hub) via
  ui/components/CrewTallyBrandMark.kt. The PDF statement header cannot inflate a resource on
  the JVM test path, so it redraws THIS geometry from report/BrandMarkGeometry.kt — keep the
  two in sync; BrandMarkGeometryTest pins the numbers.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="1000"
    android:viewportHeight="1000">

    <!-- Grey frame: left edge, bottom edge, then the two stubs that leave the
         top-right corner open. -->
    <path
        android:fillColor="#6F7072"
        android:pathData="M60,60 H126 V940 H60 Z" />
    <path
        android:fillColor="#6F7072"
        android:pathData="M60,874 H940 V940 H60 Z" />
    <path
        android:fillColor="#6F7072"
        android:pathData="M60,60 H484 V126 H60 Z" />
    <path
        android:fillColor="#6F7072"
        android:pathData="M874,518 H940 V940 H874 Z" />

    <!-- Navy arrow: corner bracket (top bar + right bar), the 45 degree shaft,
         and the L-shaped arrowhead pointing down-left. -->
    <path
        android:fillColor="#013B7A"
        android:pathData="M556,60 H940 V132 H556 Z" />
    <path
        android:fillColor="#013B7A"
        android:pathData="M868,60 H940 V446 H868 Z" />
    <path
        android:fillColor="#013B7A"
        android:pathData="M448,187 H520 V552 H448 Z" />
    <path
        android:fillColor="#013B7A"
        android:pathData="M448,480 H815 V552 H448 Z" />
    <path
        android:fillColor="#013B7A"
        android:pathData="M503,548 L936,115 L885,64 L452,497 Z" />
</vector>
